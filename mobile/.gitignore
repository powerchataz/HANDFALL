# Dependencies — regenerated by `npm install`
node_modules/

# Copied web assets — regenerated by `npm run sync-web` + `npx cap sync`.
# The repo-root index.html/manifest.json/icons are the single source of
# truth; these are pure derived copies, never hand-edited, so committing
# them would just be three (soon out of sync) copies of the same files.
www/
android/app/src/main/assets/public/
ios/App/App/public/

# Native build output — regenerated by Xcode/Gradle builds
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/

# Xcode/Android Studio local editor state
*.xcuserstate
.idea/
*.iml

# Local env / signing (never commit real signing keys or credentials)
.env
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
GoogleService-Info.plist
google-services.json
